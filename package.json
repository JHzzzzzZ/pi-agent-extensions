      "./src/extensions/chatanywhere-provider/index.ts",
      "./src/extensions/provider-quota/index.ts",
      "./src/extensions/run-timer/index.ts",
      "./src/extensions/loop/index.ts",
      "./src/extensions/goal/index.ts",
      "./src/extensions/opencode-bridge/index.ts",
      "./src/extensions/deep-init/index.ts",
      "./src/extensions/human-notify/index.ts",
      "./src/extensions/solo-mode/index.ts"
    ]
